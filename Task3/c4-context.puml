@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма (C4 Level 1): Онлайн-открытие депозитов — MVP

Person(new_client, "Новый клиент", "Клиент без счёта в банке;\nподаёт заявку на депозит через сайт")
Person(existing_client, "Существующий клиент", "Клиент с действующим счётом;\nподаёт заявку на депозит в интернет-банке")
Person(cc_manager, "Менеджер кол-центра", "Обрабатывает заявки с сайта,\nзвонит клиенту")
Person(backoffice_manager, "Менеджер бэк-офиса", "Обрабатывает заявки в АБС (MVP),\nподтверждает условия депозита")
Person(backoffice_staff, "Сотрудники бэк-офиса\n(депозиты / кредиты)", "Управляют ставками по депозитам")

System(website, "Сайт", "Отображает список депозитов и ставок;\nпринимает заявки от новых клиентов (ФИО, телефон)")
System(internet_banking, "Интернет-банк", "Отображает депозиты и персонализированные ставки;\nпринимает заявки от существующих клиентов;\nподтверждает операции через СМС-код")

System_Ext(abs, "АБС", "Автоматизированная банковская система:\nхранит ставки, обрабатывает заявки,\nоткрывает депозиты, отправляет СМС")
System_Ext(callcenter, "Система кол-центра", "Сторонняя платформа;\nпередаёт заявки менеджерам")
System_Ext(sms_gateway, "СМС-шлюз", "Отправка СМС-уведомлений клиентам;\nнаходится в ведении IT-отдела банка")

Rel(new_client, website, "Просматривает депозиты,\nоставляет заявку")
Rel(existing_client, internet_banking, "Просматривает депозиты,\nподаёт заявку,\nподтверждает через СМС-код")
Rel(cc_manager, callcenter, "Принимает заявку,\nзвонит клиенту")
Rel(backoffice_manager, abs, "Обрабатывает заявки,\nподтверждает условия депозита")
Rel(backoffice_staff, abs, "Управляет ставками депозитов")

Rel(website, callcenter, "Передаёт заявку\nна обратный звонок")
Rel(internet_banking, abs, "Передаёт заявку на открытие депозита\n(асинхронно, без прямых API-вызовов)")
Rel(abs, sms_gateway, "Отправляет СМС:\nкод подтверждения,\nстатус заявки,\nоткрытие депозита")
Rel(sms_gateway, existing_client, "СМС-уведомления")

@enduml
